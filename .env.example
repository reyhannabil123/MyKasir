# Connection string dari Neon (Dashboard Neon > Connect > pooled connection)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Kunci rahasia untuk sesi login. Buat dengan: openssl rand -base64 32
AUTH_SECRET=ganti-dengan-teks-acak-minimal-32-karakter
